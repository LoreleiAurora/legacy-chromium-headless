FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    libappindicator3-1 \
    libcurl4 \
    libgbm1 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libnss3 \
    libgconf-2-4 \
    libfontconfig1 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libgtk-3-0 \
    libpango-1.0-0 \
    lsb-release \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ARG CHROME_URL
ARG CHROME_DRIVER_URL
ARG CHROME_CACHE_PATH
ARG CHROME_DRIVER_CACHE_PATH
ARG CHROME_MAJOR_VERSION
ARG CHROME_VERSION
ARG CHROME_DRIVER_MAJOR_VERSION
ARG CHROME_DRIVER_VERSION

ENV CHROME_URL=${CHROME_URL} \
    CHROME_MAJOR_VERSION=${CHROME_MAJOR_VERSION} \
    CHROME_VERSION=${CHROME_VERSION} \
    CHROME_DRIVER_URL=${CHROME_DRIVER_URL} \
    CHROME_DRIVER_MAJOR_VERSION=${CHROME_DRIVER_MAJOR_VERSION} \
    CHROME_DRIVER_VERSION=${CHROME_DRIVER_VERSION}

COPY ${CHROME_CACHE_PATH} /tmp/chrome.deb
RUN dpkg -i /tmp/chrome.deb; apt-get install -y \
    && rm /tmp/chrome.deb \
    && ln -sf /opt/google/chrome/google-chrome /usr/local/bin/google-chrome

COPY ${CHROME_DRIVER_CACHE_PATH} /tmp/chromedriver.zip
RUN unzip -q /tmp/chromedriver.zip chromedriver -d /usr/local/bin/ \
    && chmod +x /usr/local/bin/chromedriver \
    && rm /tmp/chromedriver.zip

CMD ["google-chrome", "--no-sandbox", "--version"]