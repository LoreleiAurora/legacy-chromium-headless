FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    unzip \
    libglib2.0-0 \
    libnss3 \
    libfontconfig1 \
    libx11-6 \
    libxcb1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    ca-certificates \
    fonts-liberation \
    libasound2t64 \
    libatk1.0-0t64 \
    libatk-bridge2.0-0t64 \
    libcups2t64 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0t64 \
    libpango-1.0-0 \
    libvulkan1 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

ARG CHROME_URL
ARG CHROME_DRIVER_URL
ARG CHROME_CACHE_PATH
ARG CHROME_DRIVER_CACHE_PATH
ARG CHROME_MAJOR_VERSION
ARG CHROME_VERSION
ARG CHROME_DRIVER_MAJOR_VERSION
ARG CHROME_DRIVER_VERSION

ENV CHROME_URL=${CHROME_URL} \
    CHROME_MAJOR_VERSION=${CHROME_MAJOR_VERSION} \
    CHROME_VERSION=${CHROME_VERSION} \
    CHROME_DRIVER_URL=${CHROME_DRIVER_URL} \
    CHROME_DRIVER_MAJOR_VERSION=${CHROME_DRIVER_MAJOR_VERSION} \
    CHROME_DRIVER_VERSION=${CHROME_DRIVER_VERSION}

COPY ${CHROME_CACHE_PATH} /tmp/chrome.zip
RUN unzip -q /tmp/chrome.zip -d /opt/ \
    && ln -sf /opt/chrome-linux64/chrome /usr/local/bin/google-chrome \
    && chmod +x /opt/chrome-linux64/chrome \
    && rm /tmp/chrome.zip

COPY ${CHROME_DRIVER_CACHE_PATH} /tmp/chromedriver.zip
RUN mkdir -p /tmp/cd && unzip -q /tmp/chromedriver.zip -d /tmp/cd/ \
    && if [ -f /tmp/cd/chromedriver-linux64/chromedriver ]; then \
        mv /tmp/cd/chromedriver-linux64/chromedriver /usr/local/bin/chromedriver; \
    else \
        mv /tmp/cd/chromedriver /usr/local/bin/chromedriver; \
    fi \
    && chmod +x /usr/local/bin/chromedriver \
    && rm -rf /tmp/chromedriver.zip /tmp/cd

CMD ["google-chrome", "--no-sandbox", "--version"]
